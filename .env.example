# ---- Server ----
PORT=3000
# Public URL this app is reachable at (used for Google OAuth redirect).
# For local dev: http://localhost:3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# ---- LLM (NanoGPT / OpenAI-compatible) ----
# Set to openai | openai-compat | anthropic | ollama
LLM_PROVIDER=openai-compat
# Your NanoGPT API key
LLM_API_KEY=sk-xxxxxxxx
# NanoGPT base URL
LLM_API_BASE=https://api.nanogpt.dev/v1
# Model to use (Qwen/Gemma via NanoGPT multi-model key).
LLM_MODEL=qwen3.8-27b

# ---- Anthropic (only if LLM_PROVIDER=anthropic) ----
ANTHROPIC_API_KEY=

# ---- Ollama (only if LLM_PROVIDER=ollama) ----
OLLAMA_BASE=http://localhost:11434

# ---- Google Calendar OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
